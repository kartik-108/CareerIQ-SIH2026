# Copy to .env.staging and fill every value before starting the staging compose stack.
NODE_ENV=production
PORT=5000
API_BASE_PATH=/api
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_ANON_KEY=replace-with-anon-key
CORS_ALLOWED_ORIGINS=https://staging.example.com
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_EMBED_DIM=768
AI_TIMEOUT_MS=120000
OLLAMA_MAX_TOKENS=256
SSE_HEARTBEAT_MS=12000
ALLOW_DEV_AUTH_BYPASS=false
DEV_RAG_INSPECTOR=false
TRUST_PROXY=1
