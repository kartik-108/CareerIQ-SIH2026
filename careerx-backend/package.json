{
  "name": "careerx-backend",
  "version": "1.0.0",
  "description": "CareerX — AI Powered Skill Intelligence & Career Readiness Platform (SIH26134, Govt. of Maharashtra) — Backend",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "staging:smoke": "node scripts/staging-smoke.mjs",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "migrate": "node src/db/migrate.js",
    "migration:preflight": "node scripts/migration-preflight.mjs",
    "seed": "node src/db/seed/seed.js",
    "rag:ingest": "node src/rag/ingest.js",
    "knowledge:import": "node src/scripts/knowledge-import.js",
    "knowledge:embed": "node src/scripts/knowledge-embed.js",
    "knowledge:reindex": "node src/scripts/knowledge-reindex.js",
    "knowledge:delete": "node src/scripts/knowledge-delete.js",
    "knowledge:stats": "node src/scripts/knowledge-stats.js",
    "knowledge:verify": "node src/scripts/knowledge-verify.js"
  },
  "dependencies": {
    "@langchain/textsplitters": "^1.0.1",
    "@supabase/supabase-js": "^2.45.4",
    "@upstash/redis": "^1.34.3",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.2",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "pino-pretty": "^11.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "transform": {}
  }
}
