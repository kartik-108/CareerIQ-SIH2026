NODE_ENV=development
PORT=5000
API_BASE_PATH=/api
CORS_ALLOWED_ORIGINS=http://localhost:5500

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=llava:latest
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_DIM=768
OLLAMA_TIMEOUT=120000
OLLAMA_TIMEOUT_MS=30000
OLLAMA_KEEP_ALIVE=10m
OLLAMA_MAX_TOKENS=2048
OLLAMA_TEMPERATURE=0.2
AI_TIMEOUT_MS=120000
SSE_HEARTBEAT_MS=12000
DEV_RAG_INSPECTOR=false
ALLOW_DEV_AUTH_BYPASS=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
MAX_UPLOAD_MB=25
VISION_MAX_UPLOAD_MB=25
CACHE_TTL_RESUME_ANALYSIS=86400
CACHE_TTL_VISION_REPORT=86400
CACHE_TTL_RAG_ANSWER=3600
CACHE_TTL_JOB_RECOMMENDATIONS=1800
CACHE_TTL_ROADMAP=86400

SUPABASE_BUCKET_RESUMES=resumes
SUPABASE_BUCKET_REPORTS=reports
SUPABASE_BUCKET_AVATARS=avatars
SUPABASE_BUCKET_EXPORTS=exports

RAG_CHUNK_SIZE_TOKENS=500
RAG_CHUNK_OVERLAP_TOKENS=100
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.55
